[Unit]
Description=LENTERA SX1278 LoRa receiver (%i)
After=lentera-backend@%i.service
Wants=lentera-backend@%i.service

[Service]
Type=simple
User=%i
SupplementaryGroups=spi gpio
WorkingDirectory=/opt/lentera/python-app
Environment=LENTERA_CONFIG=/opt/lentera/python-app/lentera.toml
ExecStart=/opt/lentera/python-app/.venv/bin/python -m lentera receiver
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077

[Install]
WantedBy=multi-user.target
